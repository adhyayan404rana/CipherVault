{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build_frontend.cjs",
  "installCommand": "",
  "outputDirectory": "frontend_dist",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://ciphervault-streamlit.onrender.com/api/:path*"},
    {"source": "/health", "destination": "https://ciphervault-streamlit.onrender.com/health"}
  ],
  "headers": [
    {"source": "/:path*", "headers": [
      {"key": "Cache-Control", "value": "no-store"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://evqmzezpiyvfdbswhfvi.supabase.co; img-src 'self' blob: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]}
  ]
}
