GEMINI_API_KEY=
# Optional: a generateContent model available to your account.
# If empty, CipherVault discovers a supported Flash model via models.list.
GEMINI_MODEL=

# Optional hosted edition. Leave local to test two accounts at localhost:8502.
CIPHERVAULT_HOSTED_MODE=local
# For the Render backend set mode=supabase and configure these in Render.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIPHERVAULT_SESSION_SECRET=

# Render backend only; local account demo can leave these unset/false.
CIPHERVAULT_API_ONLY=false
CIPHERVAULT_PUBLIC_ORIGIN=

# Separate original Streamlit demonstration on Render (leave false locally).
CIPHERVAULT_RENDER_DEMO=false
# Render only: a random access password of at least 20 characters.
CIPHERVAULT_DEMO_PASSWORD=
